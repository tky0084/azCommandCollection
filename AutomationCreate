#========================================-
#①Automatinに関する変数の定義
#========================================-
######本番 / 検証環境の変数######
# 管理グループのID（環境ごと）
$MgName = "Sandbox"

# 環境区分の略称(prod/stg)（環境ごと）
$MgNameShort = "dev"

######Automationリソース情報######
# Automationアカウントを格納するためのサブスクリプションID（固定）
$Subscription = "43fa8ed1-43a0-4962-ae68-07d4c730a15c"

# Automationアカウントを格納するためのリソースグループ名（固定）
$RG = "rg-hub-$MgNameShort-automation-01"

# AzureAutomationのリソース名（固定）
$AutomationName = "aa-hub-$MgNameShort-diagAuditPolicy-01"

$roleName = "Resource Policy Contributor"

######Runbookに関する変数の定義######
# 監査用Runbook名（固定）
$RunbookNameAudit = "runbook-hub-$MgNameShort-diagAuditPolicy-01"

# 各Runbookのランタイム環境（固定）
$runtimeName = "PowerShell_76"

$apiVersion = "2024-10-23"

#========================================
#③各Runbookの実行エラーアラートに関する変数の変数の定義
#========================================
# Runbookのエラー通知のためのアラートルール名（固定）
$AlertNameErrorRb = "ar-ipgp-$MgNameShort-rberror-01"

# 上記アラートの通知用のアクショングループのリソースID(ExpressRouteのアラートルール)（固定）
$AgNotifyId = "/subscriptions/c6747f3a-f7aa-46ca-afc6-28942c8df653/resourceGroups/testag/providers/microsoft.insights/actiongroups/agtest01"

# アラートのエラーについて検索するクエリ（固定）
$QueryRbError = @"
AzureDiagnostics
| where ResourceId contains "$AutomationName"
| where RunbookName_s in ("$RunbookNameAudit","$RunbookNameFix")
| where ResultType == "Failed"
"@

#=====================
#④AutomationAccountの作成
#=====================
# サブスクリプションの切り替え(HubVnet)
Set-AzContext -subscription $Subscription

# リソースグループの作成
New-AzResourceGroup -Name $RG -Location "Japan East"

# AutomationAccountの作成(HubVnet)
New-AzAutomationAccount `
    -ResourceGroupName "$RG" `
    -Name $AutomationName `
    -Location "Japan East" `
    -AssignSystemIdentity `
    -DisablePublicNetworkAccess

#=====================
#⑤ランタイム環境の作成
#=====================
$basePath = "/subscriptions/$Subscription" +
    "/resourceGroups/$RG" +
    "/providers/Microsoft.Automation" +
    "/automationAccounts/$AutomationName"

$runtimePath = "$basePath/runtimeEnvironments/$runtimeName"

$runtimeBody = @{
    name = $runtimeName
    properties = @{
        description = "test"
        runtime = @{
            language = "PowerShell"
            version  = "7.6"
        }
        defaultPackages = @{
            Az = "15.1.0"
            "Azure CLI" = "2.77.0"
        }
    }
} | ConvertTo-Json -Depth 10

$runtimeResponse = Invoke-AzRestMethod `
    -Method PUT `
    -Path "${runtimePath}?api-version=$apiVersion" `
    -Payload $runtimeBody

if ($runtimeResponse.StatusCode -notin @(200, 201, 202)) {
    throw "Runtime creation failed: $($runtimeResponse.Content)"
}

Write-Host "Runtime Environment created."

#=====================
#⑤Runbookの作成
#=====================
#監査用Runbookの作成
$runbookPath = "$basePath/runbooks/$RunbookNameAudit"

$runbookBody = @{
    location = "japaneast"
    properties = @{
        runbookType = "PowerShell"
        runtimeEnvironment = $runtimeName
        description = "Diagnostic Audit Policy Runbook"
    }
} | ConvertTo-Json -Depth 10

$runbookResponse = Invoke-AzRestMethod `
    -Method PUT `
    -Path "${runbookPath}?api-version=$apiVersion" `
    -Payload $runbookBody

if ($runbookResponse.StatusCode -notin @(200, 201, 202)) {
    throw "Runbook creation failed: $($runbookResponse.Content)"
}

#=====================
#⑥Automation変数の作成
#=====================
New-AzAutomationVariable `
    -AutomationAccountName $AutomationName `
    -Name "IpGroupResourceId" `
    -Encrypted $False `
    -Value $IpgpResourceID `
    -ResourceGroupName $RG `
    -Description "変更対象となるIPグループのリソースID"

#=====================
#⑦Automationアカウントのシステム割り当てマネージドIDに必要な権限を割り当て
#=====================
# リソース名からAutomationアカウントのシステム割り当てマネージドIDを特定
$SysMgID = (Get-AzAutomationAccount -ResourceGroupName $RG -Name $AutomationName).Identity.PrincipalId

#管理グループへの閲覧者権限を付与
# 環境固有の管理グループ
New-AzRoleAssignment `
    -ObjectId $SysMgID `
    -RoleDefinitionName $roleName `
    -Scope "/providers/Microsoft.Management/managementGroups/$MgName"

# Automationアカウントのサブスクリプションに切り替え
Set-AzContext -subscription $Subscription

#=====================
#⓾アラートルール(Runbook実行エラー通知)の作成
#=====================
# AutomationアカウントのリソースIDを特定(パラーメータで使用するため)
$AutomationResourceID = (Get-AzResource -ResourceGroupName $RG -Name $AutomationName).ResourceId

$condition3 = `
    New-AzScheduledQueryRuleConditionObject `
        -Query $QueryRbError `
        -Operator "GreaterThan" `
        -TimeAggregation "Count" `
        -Threshold "0" `
        -FailingPeriodNumberOfEvaluationPeriod 1 `
        -FailingPeriodMinFailingPeriodsToAlert 1

New-AzScheduledQueryRule `
    -Name $AlertNameErrorRb `
    -ResourceGroupName $RG `
    -Description "Runbook(Ipgp)エラー通知" `
    -ActionGroupResourceId $AgNotifyId `
    -Location japaneast `
    -DisplayName $AlertNameErrorRb `
    -Scope $AutomationResourceID `
    -Severity 2 `
    -WindowSize ([System.TimeSpan]::New(0,5,0)) `
    -EvaluationFrequency ([System.TimeSpan]::New(0,5,0)) `
    -CriterionAllOf $condition3
